      "@type": "Service",
      "@id": "https://www.lohuissignature.nl/nl/trouwauto.html#service",
      "name": "Trouwauto met chauffeur",
      "description": "Een trouwauto met chauffeur: een S-Klasse of 7 Serie, of op aanvraag een Rolls-Royce Ghost of Bentley Flying Spur. Gasten apart vervoerd.",
      "serviceType": "Trouwauto met chauffeur",
