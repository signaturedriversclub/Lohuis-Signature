    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kunnen wij in Amsterdam een chauffeur per uur boeken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Een uur, een avond of een hele dag worden op dezelfde manier geregeld, en bij werk op uurbasis blijft de chauffeur bij de auto."
          }
        },
        {
          "@type": "Question",
          "name": "Waar bent u gevestigd?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Aalsmeer, op korte afstand ten zuiden van Amsterdam en op enkele minuten van Schiphol, zodat de auto nooit ver van de stad of de luchthaven is."
          }
        },
        {
          "@type": "Question",
          "name": "Kan de chauffeur in Amsterdam onze eigen auto rijden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Uw auto wordt opgehaald op het woonadres of bij kantoor, volgens dezelfde maatstaf gereden en teruggebracht zoals hij vertrok."
          }
        },
        {
          "@type": "Question",
          "name": "Kunt u meer regelen dan de auto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Tafels, kamers en gasten worden geregeld door de concierge, die naast de chauffeurs werkt en hetzelfde reisschema beheert."
          }
        }
      ]
    }