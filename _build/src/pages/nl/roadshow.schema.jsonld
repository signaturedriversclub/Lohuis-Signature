    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is het de hele roadshow dezelfde chauffeur?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Eén chauffeur blijft van de eerste tot de laatste dag bij de opdracht en kent het schema voordat het begint."
          }
        },
        {
          "@type": "Question",
          "name": "Wat als een afspraak uitloopt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dan wacht de auto. Elk traject heeft ruimte, en de volgende afspraak wordt zo nodig met u opnieuw getimed."
          }
        },
        {
          "@type": "Question",
          "name": "Kan de roadshow naar het buitenland?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, over de weg door België, Duitsland, Frankrijk, Zwitserland en Italië. Bij langere reizen overnacht de chauffeur in een hotel in de buurt."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe wordt een roadshow geprijsd?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per dag en niet naar de afstand. De volledige kosten staan vóór de eerste dag in het schriftelijke voorstel, en zonder uw akkoord komt er niets bij."
          }
        }
      ]
    }