    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can we book a chauffeur in Amsterdam by the hour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. An hour, an evening or a whole day are all arranged the same way, and on hourly work the chauffeur stays with the car."
          }
        },
        {
          "@type": "Question",
          "name": "Where are you based?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Aalsmeer, a short drive south of Amsterdam and minutes from Schiphol, so the car is never far from the city or the airport."
          }
        },
        {
          "@type": "Question",
          "name": "Can the chauffeur drive our own car in Amsterdam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Your car is collected from the residence or office, driven to the same standard, and returned as it left."
          }
        },
        {
          "@type": "Question",
          "name": "Can you arrange more than the car?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tables, rooms and guests are handled by the concierge, who works alongside the chauffeurs and holds the same itinerary."
          }
        }
      ]
    }